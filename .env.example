# SP4 Core Agent - Environment Variables for Railway

# Server Configuration
PORT=3001
NODE_ENV=production
# Protected bridge endpoints fail closed when this token is missing or empty.
BRIDGE_AUTH_TOKEN=
# DEV-only compatibility. Production ignores this opt-in and always requires auth.
BRIDGE_ALLOW_LOCALHOST_BYPASS=false
# Exact browser origins, comma-separated. Blank denies browser CORS by default.
BRIDGE_ALLOWED_ORIGIN=
# Development example: http://localhost:9000,http://127.0.0.1:9000

# Ollama Configuration (if using external Ollama service)
# OLLAMA_HOST=http://your-ollama-server:11434

# Memory Configuration
MEMORY_PATH=./data/memory.json
IDENTITY_PATH=./data/identity.json

# Feature Flags
ENABLE_MEMORY=true
ENABLE_CONSOLIDATION=false
ENABLE_SCHEDULER=false
# Cloud fallback is fail-closed. Set true only after an explicit policy decision.
USE_CLOUD_FALLBACK=false

# Logging
LOG_LEVEL=info

# API Keys (if needed)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Claude API toggle (false = vypne všetky Claude volania, zvyšok bridgeu funguje)
# CLAUDE_API_ENABLED=true
