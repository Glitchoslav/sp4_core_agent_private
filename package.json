{
  "name": "sp4-os",
  "version": "1.4.0",
  "description": "🔥 SP4 OS v1.4.0 — Lokálny AI operačný systém. Multi-agent, policy-driven routing, privacy-first. Be real. Be free.",
  "type": "module",
  "main": "index_v07.js",
  "scripts": {
    "start": "node sp4.js start",
    "status": "node sp4.js status",
    "doctor": "node sp4.js doctor",
    "cli": "node index_v07.js",
    "dev": "node index_v07.js",
    "server:legacy": "node server.js",
    "http:legacy": "node start-http-server.js",
    "bridge": "node bridge-server.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('data/memory.json',{ force:true }); console.log('Removed data/memory.json');\"",
    "consolidate": "node scripts/runConsolidation.js",
    "test:drift": "node scripts/testIdentityDrift.js",
    "test:memory": "node scripts/testMemorySystem.js",
    "test:identity:m1": "node --test tests/test_m1_identity_auth_api.js tests/test_bridge_identity_auth_contract.js",
    "test:actions": "node tests/test_action_layer_basic.js",
    "test:gate": "node scripts/runGate.js --required-step=tests/test_runtime_authority_contract.js",
    "test:gate:isolated": "node scripts/runIsolatedGate.js",
    "test:gate:win": "node tests/test_runtime_authority_contract.js && node tests/test_workspace_docs_contract.js && node tests/test_runtime_authority_guard_contract.js && node tests/unit/test_identity_kernel_contract.js && node tests/test_prompt_assembly_identity_contract.js && node tests/test_immune_identity_all_personas.js && node test_metadata_contract.js && node test_persona_integrity.js && set SP4_TEST=true&& node test_enforcer_scenario.js",
    "test:cloud": "node test_enforcer_cloud.js",
    "test:smoke": "node test_smoke.js",
    "test:quality:short-tech": "node tests/test_short_tech_quality_gate.js",
    "test:policy:local": "node test_policy_local_default.js",
    "test:policy:cloud:contract": "node test_policy_allow_cloud_contract.js",
    "test:policy:force:local": "node test_policy_force_local_contract.js",
    "test:runtime:authority": "node tests/test_runtime_authority_contract.js",
    "test:workspace:docs": "node tests/test_workspace_docs_contract.js",
    "test:live:offline": "node tests/test_009_live_offline_eval.mjs",
    "test:live:battletest:prep": "node battletest.js --prepare",
    "test:live:battletest": "node battletest.js",
    "test:live:battletest:testmode": "cross-env SP4_TEST=true node battletest.js",
    "test:live:battletest:50:prep": "cross-env SP4_BATTLETEST_ID=test_010 node battletest.js --prepare",
    "test:live:battletest:50": "cross-env SP4_BATTLETEST_ID=test_010 node battletest.js",
    "test:live:optruth": "node tests/test_011_operational_truth_eval.mjs",
    "test:live:privacy": "node tests/test_012_privacy_truth_eval.mjs",
    "test:cloud:smoke": "node test_cloud_execution_smoke.js",
    "sp4:local": "node index_v07.js",
    "sp4:cloud": "cross-env SP4_ALLOW_CLOUD=true node index_v07.js",
    "export:dataset": "node export_training_data.js",
    "test:constitution": "node tests/test_constitution_gate.js && node tests/test_litellm_canonical_egress.js && node tests/test_egress_orchestrator.js",
    "test": "npm run test:constitution",
    "test:smoke:runtime": "node tests/smoke_test.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "grammy": "^1.38.4",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1"
  },
  "keywords": [
    "SP4",
    "AI",
    "offline",
    "ollama",
    "local",
    "hierarchical-memory",
    "episodic-memory",
    "semantic-memory",
    "emotional-memory",
    "relationship-evolution",
    "pattern-detection",
    "multi-voice-synthesis",
    "personal-ai",
    "digital-symbiote",
    "privacy-first",
    "bad-labs",
    "neuroscience-inspired",
    "shadow-work",
    "meta-reflection",
    "field-tactics",
    "relationship-milestones",
    "memory-triggers"
  ],
  "author": "SP4 Community + BAD Labs",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "railway": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
